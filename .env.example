# Keep real secrets only in .env. Never paste them into chat.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safe default: Binance Spot testnet.
# Spot production REST base URL is https://api.binance.com
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_RECV_WINDOW=5000

# Real orders require both this value and an explicit CLI confirmation flag.
ALLOW_LIVE_TRADING=false

# USD-M Futures uses a separate testnet/demo endpoint and usually separate keys.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_RECV_WINDOW=5000
ALLOW_FUTURES_LIVE_TRADING=false
